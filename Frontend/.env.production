# Valores públicos del build de producción (sin secretos).
# Los secretos (AUTH_SECRET, DATABASE_URL, claves de IA y redes) van solo en Vercel.
VITE_APP_MODE=production

VITE_LINKEDIN_OAUTH_REDIRECT_URI=https://campus-social-indol.vercel.app/oauth/linkedin
VITE_META_OAUTH_REDIRECT_URI=https://campus-social-indol.vercel.app/oauth/meta
VITE_TIKTOK_OAUTH_REDIRECT_URI=https://campus-social-indol.vercel.app/oauth/tiktok
