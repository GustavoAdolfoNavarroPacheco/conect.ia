# Copia este archivo a .env para desarrollo local (ver README).
# En producción las variables van en Vercel → Settings → Environment Variables.

# production = app real (sin barra de diseño Figma). Omitir o design = vista de 8 pantallas
VITE_APP_MODE=production

# Redirecciones OAuth de cada red. Deben coincidir EXACTO con las URLs registradas en cada plataforma.
VITE_LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/linkedin
VITE_META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/meta
VITE_TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/tiktok
