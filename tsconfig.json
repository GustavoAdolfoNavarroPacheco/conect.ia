{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true
  },
  "include": [
    "api/fn/**/*.ts",
    "api/cron/**/*.ts",
    "api/blob-upload.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "server/auth/config.ts"
  ]
}
